---
import Base from '../../layouts/Base.astro';
import MapaMicelio from '../../components/MapaMicelio.astro';
import GlifoEstado from '../../components/GlifoEstado.astro';
import { getCollection, render } from 'astro:content';
import { backlinksDe, construirRed } from '../../lib/grafo';
import { ESTADOS } from '../../lib/estados';
import { paginaConcepto } from '../../lib/estructurados';

export async function getStaticPaths() {
  const conceptos = await getCollection('conceptos');
  return conceptos.map((c) => ({ params: { slug: c.id }, props: { entrada: c } }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);
const d = entrada.data;
const est = ESTADOS[d.estado];

const backlinksCrudos = await backlinksDe(entrada.id);
const { conceptos } = await construirRed();
const porSlug = new Map(conceptos.map((c) => [c.slug, c]));

// Las hifas se muestran como fichas, no como una lista de títulos: para eso
// necesitan el concepto entero (etapa, dominio, resumen), no solo el slug.
const salientes = d.conecta.map((s) => porSlug.get(s)).filter((c) => c !== undefined);
const entrantesTodas = backlinksCrudos
  .map((b) => porSlug.get(b.slug))
  .filter((c) => c !== undefined);

// Una hifa mutua no son dos hifas: se declara de los dos lados. Como ficha la
// duplicación se ve —dos pliegos idénticos, uno debajo del otro—, así que la
// conexión se muestra una sola vez, del lado que sale, marcada como mutua.
const salen = new Set(salientes.map((c) => c.slug));
const backlinks = entrantesTodas.filter((c) => !salen.has(c.slug));
const mutuas = new Set(entrantesTodas.filter((c) => salen.has(c.slug)).map((c) => c.slug));

const fmt = (x?: Date) =>
  x ? x.toLocaleDateString('es', { year: 'numeric', month: 'short' }) : null;

const esteConcepto = conceptos.find((c) => c.slug === entrada.id)!;
// Conteo aproximado sobre el markdown crudo: alcanza para wordCount.
const palabras = (entrada.body ?? '')
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const jsonLd = paginaConcepto({
  concepto: esteConcepto,
  // Deduplicadas: una hifa mutua es un `mentions` con el mismo @id dos veces.
  conexiones: [...salientes, ...backlinks].map((c) => ({ slug: c.slug, titulo: c.titulo })),
  palabras,
});
---

<Base
  titulo={`${d.titulo} — Gerardo Riarte`}
  descripcion={d.resumen}
  tipo="article"
  publicada={d.plantada}
  modificada={d.podada ?? d.plantada}
  imagen={`/og/${entrada.id}.png`}
  jsonLd={jsonLd}
>
  <article class="contenedor nota">
    <div class="nota__cuerpo">
      <a href="/" class="campo volver">← al micelio</a>

      <div class="nota__encabezado">
        <div class="nota__glifo">
          <GlifoEstado estado={d.estado} tamano={52} />
        </div>
        <div>
          <p class="etiqueta-campo">{est.label} · {d.dominio}</p>
          <h1 class="nota__titulo">{d.titulo}</h1>
        </div>
      </div>

      <p class="nota__etapa">{est.descripcion}</p>

      {d.cosecha && (
        <div class="cosecha campo">
          <span class="cosecha__sello">cosecha</span>
          <span>{d.cosecha}</span>
        </div>
      )}

      <div class="prosa">
        <Content />
      </div>

      <div class="micelio-local">
        {[
          { titulo: 'hifas que salen', glosa: 'lo que esta nota nombra', items: salientes },
          { titulo: 'hifas que entran', glosa: 'lo que nombra a esta nota', items: backlinks },
        ]
          .filter((b) => b.items.length > 0)
          .map((bloque) => (
            <div class="micelio-local__bloque">
              <p class="etiqueta-campo">
                {bloque.titulo} <span class="micelio-local__glosa">· {bloque.glosa}</span>
              </p>
              <ul class="hifas-fichas">
                {bloque.items.map((c) => (
                  <li>
                    {/* Ficha mínima, no un renglón de lista: el borde y el
                        resumen son lo que hace legible que se puede entrar. */}
                    <a href={`/conceptos/${c.slug}`} class="hifa-ficha">
                      <span class="hifa-ficha__glifo">
                        <GlifoEstado estado={c.estado} tamano={26} />
                      </span>
                      <span class="hifa-ficha__texto">
                        <span class="hifa-ficha__meta campo">
                          {ESTADOS[c.estado].label} · {c.dominio}
                          {mutuas.has(c.slug) && (
                            <span class="hifa-ficha__mutua" title="se nombran mutuamente">
                              {' '}· ↔ mutua
                            </span>
                          )}
                        </span>
                        <span class="hifa-ficha__titulo">{c.titulo}</span>
                        {c.resumen && (
                          <span class="hifa-ficha__resumen">{c.resumen}</span>
                        )}
                      </span>
                      <span class="hifa-ficha__flecha" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
      </div>
    </div>

    <aside class="nota__ficha">
      <p class="etiqueta-campo">datos de campo</p>
      <dl class="ficha campo">
        <div><dt>etapa</dt><dd>{est.label}</dd></div>
        <div><dt>dominio</dt><dd>{d.dominio}</dd></div>
        {fmt(d.plantada) && (
          <div><dt>plantada</dt><dd>{fmt(d.plantada)}</dd></div>
        )}
        {fmt(d.podada) && (
          <div><dt>última poda</dt><dd>{fmt(d.podada)}</dd></div>
        )}
        <div>
          <dt>hifas</dt>
          <dd>{salientes.length + backlinks.length}</dd>
        </div>
      </dl>
    </aside>
  </article>

  <section class="lamina" aria-labelledby="titulo-lamina">
    <div class="contenedor lamina__encabezado">
      <h2 id="titulo-lamina" class="etiqueta-campo">dónde vive en la red</h2>
      <p class="campo lamina__pista">{d.titulo} está marcada</p>
    </div>
    <MapaMicelio activo={entrada.id} />
  </section>
</Base>

<style>
  .nota {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 3.5rem;
    align-items: start;
    padding-block: 2.5rem 4rem;
  }

  .volver {
    font-size: 0.78rem;
    color: var(--tinta-suave);
  }
  .volver:hover { color: var(--ambar-hondo); }

  .nota__encabezado {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin-top: 1.4rem;
  }
  .nota__glifo {
    padding-top: 0.35rem;
    flex-shrink: 0;
  }
  .nota__titulo {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    margin: 0.25rem 0 0;
  }
  .nota__etapa {
    margin: 0.9rem 0 1.8rem;
    color: var(--tinta-suave);
    font-style: italic;
    font-size: 0.98rem;
    max-width: 52ch;
  }

  .cosecha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem;
    border: 1px solid var(--ambar-hondo);
    border-left-width: 4px;
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.86rem;
    background: rgba(196, 135, 26, 0.09);
  }
  .cosecha__sello {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
    font-size: 0.7rem;
    color: var(--ambar-hondo);
  }

  .micelio-local {
    margin-top: 3.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--filete);
    display: grid;
    gap: 2.2rem;
  }
  .micelio-local__glosa {
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: none;
    opacity: 0.8;
  }

  .hifas-fichas {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.8rem;
    /* minmax(0,…) por el mismo motivo que la grilla de la nota: sin el 0 el
       resumen largo estira la columna en vez de recortarse. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
  }

  /* Ficha de hifa: el pliego de herbario en versión mínima. Mismo doble
     filete que en el índice, para que se lea como el mismo objeto. */
  .hifa-ficha {
    display: flex;
    gap: 0.75rem;
    height: 100%;
    padding: 0.85rem 0.9rem;
    background: var(--papel-alto);
    border: 1px solid var(--filete);
    box-shadow: inset 0 0 0 1px var(--papel-alto), inset 0 0 0 2px var(--filete-tenue);
    transition: border-color 0.25s ease;
  }
  .hifa-ficha:hover {
    border-color: var(--tinta);
    color: var(--tinta);
  }

  .hifa-ficha__glifo {
    flex-shrink: 0;
    padding-top: 0.15rem;
  }
  .hifa-ficha__texto {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }
  .hifa-ficha__meta {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .hifa-ficha__mutua { color: var(--ambar-hondo); }
  .hifa-ficha__titulo {
    font-family: var(--fuente-especimen);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.22;
    /* El subrayado permanente es la señal de link; el hover solo lo enciende. */
    border-bottom: 1px solid var(--filete);
    padding-bottom: 2px;
    justify-self: start;
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .hifa-ficha:hover .hifa-ficha__titulo,
  .hifa-ficha:focus-visible .hifa-ficha__titulo {
    color: var(--ambar-hondo);
    border-bottom-color: var(--ambar-hondo);
  }
  .hifa-ficha__resumen {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--tinta-suave);
    /* Dos líneas: la ficha insinúa, la nota desarrolla. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hifa-ficha__flecha {
    flex-shrink: 0;
    align-self: flex-start;
    font-size: 0.9rem;
    line-height: 1;
    color: var(--tinta-suave);
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .hifa-ficha:hover .hifa-ficha__flecha,
  .hifa-ficha:focus-visible .hifa-ficha__flecha {
    color: var(--ambar-hondo);
    transform: translate(1px, -1px);
  }

  /* Ficha lateral: la etiqueta del pliego, tipeada. */
  .nota__ficha {
    position: sticky;
    top: 1.5rem;
    border: 1px solid var(--filete);
    background: var(--papel-alto);
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .ficha {
    margin: 0.8rem 0 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.78rem;
  }
  .ficha > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.1rem;
  }
  .ficha dt {
    color: var(--tinta-suave);
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.68rem;
  }
  .ficha dd { margin: 0; }

  .lamina {
    padding-block: 1.8rem 2.2rem;
    border-block: 1px solid var(--filete);
  }
  .lamina__encabezado {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }
  .lamina__pista {
    font-size: 0.76rem;
    color: var(--tinta-suave);
  }

  @media (max-width: 860px) {
    .nota {
      /* minmax(0, 1fr) y no 1fr: un `1fr` pelado deja el min-width:auto del
         ítem, y cualquier contenido que no se reflowea —un diagrama de texto,
         una tabla ancha— estira la columna y saca a la página entera de foco
         con scroll horizontal. Misma defensa que en la grilla de escritorio. */
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .nota__ficha { position: static; }
  }
</style>
