---
import { construirRed } from '../lib/grafo';
import { tenderMicelio } from '../lib/micelio';
import { GLIFOS } from '../lib/glifos';
import { ESTADOS } from '../lib/estados';

interface Props {
  /** Slug a dejar resaltado de forma permanente (en la página de una nota). */
  activo?: string;
}
const { activo } = Astro.props;

const { conceptos, aristas, dominios } = await construirRed();
const laminas = tenderMicelio(conceptos, aristas, dominios);
---

<figure class="corte" data-activo={activo ?? ''}>
  {
    laminas.map((lam) => (
      <div class={`hoja hoja--${lam.modo}`}>
        <svg
          viewBox={`0 0 ${lam.lienzo.ancho} ${lam.lienzo.alto}`}
          role="group"
          aria-label="Corte de tierra: los conceptos como micelio, a más profundidad cuanto menos maduros. Los cuerpos fructíferos asoman sobre la superficie."
        >
          <defs>
            <linearGradient id={`perfil-suelo-${lam.modo}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#dccca9" stop-opacity="0.55" />
              <stop offset="55%" stop-color="#d3c199" stop-opacity="0.7" />
              <stop offset="100%" stop-color="#cbb78f" stop-opacity="0.9" />
            </linearGradient>
            <linearGradient id={`luz-aire-${lam.modo}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f2eada" stop-opacity="0.9" />
              <stop offset="100%" stop-color="#f0e7d3" stop-opacity="0.25" />
            </linearGradient>

            {/* --- volumen del cuerpo fructífero ---
                Los tres van en objectBoundingBox (el default), así que el
                mismo degradado se adapta a la caja de cada hongo: la luz cae
                del mismo lado para todos sin calcular nada por nodo.
                La fuente está arriba a la izquierda, y es la misma para el
                sombrero, el tallo y la sombra de apoyo. */}
            {/* Los stops cierran antes del 100%: el radio de un radialGradient
                en objectBoundingBox se mide contra la caja, no contra la
                silueta, así que un stop al 100% cae en una esquina que el
                sombrero no ocupa y el domo termina leyéndose plano. */}
            <radialGradient id={`domo-${lam.modo}`} cx="34%" cy="12%" r="74%">
              <stop offset="0%" stop-color="#efc271" />
              <stop offset="38%" stop-color="#cd8d1c" />
              <stop offset="72%" stop-color="#a56c11" />
              <stop offset="100%" stop-color="#7a5010" />
            </radialGradient>
            {/* El margen enrollado es la parte que no recibe luz. Va como
                capa aparte sobre el mismo path: así el degradado del domo no
                tiene que resolver a la vez el volumen y la sombra. */}
            <linearGradient id={`margen-${lam.modo}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2a2018" stop-opacity="0" />
              <stop offset="56%" stop-color="#2a2018" stop-opacity="0" />
              <stop offset="100%" stop-color="#2a2018" stop-opacity="0.34" />
            </linearGradient>
            <linearGradient id={`carne-${lam.modo}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#f7f1e4" />
              <stop offset="44%" stop-color="#f0e7d3" />
              <stop offset="100%" stop-color="#d7c8ab" />
            </linearGradient>
            {/* El hongo apoya en la tierra en vez de flotar sobre ella. */}
            <radialGradient id={`poso-${lam.modo}`}>
              <stop offset="0%" stop-color="#2a2018" stop-opacity="0.34" />
              <stop offset="62%" stop-color="#2a2018" stop-opacity="0.11" />
              <stop offset="100%" stop-color="#2a2018" stop-opacity="0" />
            </radialGradient>
          </defs>

          {/* --- las dos zonas del corte --- */}
          <rect
            x="0"
            y="0"
            width={lam.lienzo.ancho}
            height={lam.lienzo.superficie}
            fill={`url(#luz-aire-${lam.modo})`}
          />
          <rect
            x="0"
            y={lam.lienzo.superficie}
            width={lam.lienzo.ancho}
            height={lam.lienzo.alto - lam.lienzo.superficie}
            fill={`url(#perfil-suelo-${lam.modo})`}
          />

          {/* --- reglas de estrato (solo en la vertical) --- */}
          <g class="reglas" aria-hidden="true">
            {lam.guias.filter((g) => g.regla).map((g) => <path d={g.regla} />)}
          </g>

          {/* --- la línea de superficie y su rayado --- */}
          <path class="superficie" d={lam.superficie} />
          <g class="rayado" aria-hidden="true">
            {lam.rayado.map((d) => <path d={d} />)}
          </g>

          {/* --- rootlets ambientales: hifas que mueren en la nada.
                  En dos grupos para que respiren desfasados. --- */}
          <g class="rootlets rootlets--a" aria-hidden="true">
            {lam.nodos.filter((_, i) => i % 2 === 0).flatMap((n) => n.rootlets).map((d) => <path d={d} />)}
          </g>
          <g class="rootlets rootlets--b" aria-hidden="true">
            {lam.nodos.filter((_, i) => i % 2 === 1).flatMap((n) => n.rootlets).map((d) => <path d={d} />)}
          </g>

          {/* --- las hifas que conectan conceptos: el micelio real --- */}
          <g class="hifas">
            {lam.hifas.map((h) => (
              <g class="hifa" data-a={h.desde} data-b={h.hasta}>
                <path class="hifa__filamento" d={h.d} />
                <path class="hifa__rama" d={h.rama} />
                {/* El nutriente que sube. pathLength normaliza cada filamento
                    a 100, así el mismo dasharray sirve para todos y no hay que
                    medir largos en JS. */}
                <path
                  class="hifa__savia"
                  d={h.d}
                  pathLength="100"
                  style={`--dur:${h.duracion}s; --demora:-${h.demora}s`}
                />
              </g>
            ))}
          </g>

          {/* --- los nodos --- */}
          <g class="nodos">
            {lam.nodos.map((n) => {
              const g = GLIFOS[n.estado];
              return (
                <a
                  href={`/conceptos/${n.slug}`}
                  class="nodo"
                  data-slug={n.slug}
                  data-estado={n.estado}
                  aria-label={`${n.titulo} — ${ESTADOS[n.estado].label}, dominio ${n.dominio}`}
                >
                  {/* Orden de dibujo = orden de profundidad: el tallo y su
                      anillo primero, después el sombrero, y encima de él las
                      laminillas y el tramado, que son superficie del sombrero. */}
                  {n.anatomia && (
                    <g class="fruto">
                      {/* Primero la sombra de apoyo: va DEBAJO del tallo, si
                          no le pisa el bulbo y se lee como un charco. */}
                      <ellipse
                        class="fruto__poso"
                        cx={n.anatomia.pieX + n.anatomia.pieAncho * 0.5}
                        cy={lam.lienzo.superficie + 4}
                        rx={n.anatomia.pieAncho * 2.8}
                        ry={n.anatomia.pieAncho * 0.7}
                      />
                      <path class="fruto__tallo" d={n.anatomia.tallo} />
                      <g class="fruto__fibras">
                        {n.anatomia.fibras.map((d) => <path d={d} />)}
                      </g>
                      <path class="fruto__anillo" d={n.anatomia.anillo} />
                      <path class="fruto__sombrero" d={n.anatomia.sombrero} />
                      <path class="fruto__margen" d={n.anatomia.sombrero} />
                      {/* Las laminillas van SOBRE el relleno: en vista lateral
                          se ven en la banda del reverso, no detrás del hongo. */}
                      <g class="fruto__laminillas">
                        {n.anatomia.laminillas.map((d) => <path d={d} />)}
                      </g>
                      <g class="fruto__trama">
                        {n.anatomia.trama.map((d) => <path d={d} />)}
                      </g>
                      {/* Lo que llega por las hifas: el sombrero toma luz. */}
                      <path class="fruto__savia" d={n.anatomia.sombrero} />
                    </g>
                  )}

                  {!n.anatomia && (
                    <g class="nodo-glifo" transform={`translate(${n.x} ${n.y}) scale(1.75)`}>
                      {g.cuerpo && <path class="nodo-glifo__cuerpo" d={g.cuerpo} />}
                      {g.trazos.map((d) => <path class="nodo-glifo__trazo" d={d} />)}
                      {g.puntos?.map((p) => (
                        <circle class="nodo-glifo__punto" cx={p.cx} cy={p.cy} r={p.r} />
                      ))}
                    </g>
                  )}

                  {/* plomada a la ficha, como el hilo de un pliego */}
                  <path class="plomada" d={n.plomada} />

                  {/* La ficha va en foreignObject y no en <text>: SVG no hace
                      wrap, y un resumen de dos renglones recortados no se
                      puede partir a mano sin hornear el corte por lámina. */}
                  <foreignObject
                    x={n.ficha.x}
                    y={n.ficha.y}
                    width={n.ficha.ancho}
                    height={n.ficha.alto}
                  >
                    <div class="ficha-nodo">
                      <p class="ficha-nodo__meta">
                        {ESTADOS[n.estado].label} · {n.dominio}
                      </p>
                      <p class="ficha-nodo__titulo">
                        {n.titulo}<span class="ficha-nodo__flecha">↗</span>
                      </p>
                      {n.resumen && <p class="ficha-nodo__resumen">{n.resumen}</p>}
                    </div>
                  </foreignObject>

                  {/* zona de puntería. El contenido de la ficha no recibe
                      eventos: el objetivo son estos dos, que están adentro
                      del <a> y cubren el glifo y la caja entera. */}
                  <circle
                    class="area"
                    cx={n.anatomia ? n.anatomia.cx : n.x}
                    cy={n.anatomia ? n.anatomia.baseY : n.y}
                    r={lam.modo === 'alto' ? 44 : 30}
                  />
                  <rect
                    class="area"
                    x={n.ficha.x}
                    y={n.ficha.y}
                    width={n.ficha.ancho}
                    height={n.ficha.alto}
                  />
                </a>
              );
            })}
          </g>

          {/* --- rótulos de dominio a pie de lámina (solo panorámica) --- */}
          <g class="dominios" aria-hidden="true">
            {lam.pie.map((p) => (
              <text x={p.x} y={p.y} text-anchor="middle">{p.texto}</text>
            ))}
          </g>

          {/* --- escala / estratos --- */}
          <g class="escala" aria-hidden="true">
            {lam.guias.map((g) => (
              <text
                class={g.hito ? 'escala__hito' : undefined}
                x={g.x}
                y={g.y}
                text-anchor={g.ancla}
              >
                {g.texto}
              </text>
            ))}
          </g>
        </svg>
      </div>
    ))
  }

  <figcaption class="leyenda campo">
    <span class="solo-ancho">profundidad = madurez · horizontal = dominio</span>
    <span class="solo-alto">se baja por los estratos: cuanto más hondo, menos maduro</span>
    <span>·</span>
    <span>las hifas son las conexiones entre conceptos</span>
    <span>·</span>
    <span class="leyenda__accion">cada ficha abre su nota ↗</span>
  </figcaption>
</figure>

<style>
  .corte {
    margin: 0;
    width: 100%;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* La lámina vertical solo existe en pantallas angostas, y viceversa.
     display:none las saca también del árbol de accesibilidad y del orden
     de tabulación, así que los 6 nodos nunca se anuncian dos veces. */
  .hoja--alto { display: none; }
  .solo-alto { display: none; }

  @media (max-width: 900px) {
    .hoja--ancho { display: none; }
    .hoja--alto { display: block; }
    .solo-ancho { display: none; }
    .solo-alto { display: inline; }
  }

  /* --- el suelo --- */
  .superficie {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.6;
  }
  .rayado path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 0.9;
    opacity: 0.34;
    stroke-linecap: round;
  }
  .reglas path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 0.8;
    opacity: 0.2;
    stroke-dasharray: 3 5;
  }

  /* --- micelio ambiental --- */
  .rootlets path {
    fill: none;
    stroke: var(--tinta-hifa);
    stroke-width: 0.95;
    stroke-linecap: round;
    opacity: 0.62;
  }

  /* --- hifas de conexión --- */
  .hifa__filamento,
  .hifa__rama {
    fill: none;
    stroke: var(--tinta-hifa);
    stroke-linecap: round;
    transition: stroke 0.35s ease, stroke-width 0.35s ease, opacity 0.35s ease;
  }
  .hifa__filamento { stroke-width: 1.7; }
  .hifa__rama { stroke-width: 0.85; opacity: 0.7; }

  /* ---------------------------------------------------------------
     La savia. Un tramo corto de trazo que recorre el filamento desde el
     extremo menos maduro hacia el más maduro: el nutriente que sube a
     alimentar al cuerpo fructífero.

     Con pathLength="100" el período del dasharray iguala al largo del
     trazo, así que hay exactamente UN destello a la vez por hifa y el
     ciclo cierra sin salto. dashoffset 100 -> 0 lo mueve hacia adelante.
     --------------------------------------------------------------- */
  .hifa__savia {
    fill: none;
    stroke: var(--ambar);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 7 93;
    opacity: 0.75;
    animation: savia var(--dur, 8s) linear infinite;
    animation-delay: var(--demora, 0s);
    transition: stroke-width 0.35s ease, opacity 0.35s ease;
  }
  @keyframes savia {
    from { stroke-dashoffset: 100; }
    to   { stroke-dashoffset: 0; }
  }

  /* El sombrero toma luz cuando lo alimentan. */
  .fruto__savia {
    fill: #f2c86c;
    stroke: none;
    opacity: 0;
    animation: nutrir 7s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes nutrir {
    0%, 62%, 100% { opacity: 0; }
    78%           { opacity: 0.6; }
  }

  /* --- nodos --- */
  .nodo { cursor: pointer; }
  .area { fill: transparent; }

  .nodo-glifo__trazo {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.15;
    stroke-linecap: round;
  }
  .nodo-glifo__punto { fill: var(--tinta); }
  .nodo-glifo__cuerpo {
    fill: none;
    stroke: var(--tinta-suave);
    stroke-width: 1.15;
  }
  .nodo[data-estado='semilla'] .nodo-glifo__trazo {
    stroke: var(--tinta-suave);
  }
  .nodo[data-estado='flor'] .nodo-glifo__punto { fill: var(--musgo); }

  /* --- cuerpos fructíferos: lo único cálido, y lo único sobre tierra ---

     Las dos láminas están las dos en el DOM, así que sus <defs> no pueden
     compartir id. Cada hoja declara a cuál de los dos juegos apunta y el
     resto de las reglas usa la variable: así el fill vive en CSS y no en un
     atributo de presentación, que el CSS terminaría pisando igual. */
  .hoja--ancho {
    --domo: url(#domo-ancho);
    --margen: url(#margen-ancho);
    --carne: url(#carne-ancho);
    --poso: url(#poso-ancho);
  }
  .hoja--alto {
    --domo: url(#domo-alto);
    --margen: url(#margen-alto);
    --carne: url(#carne-alto);
    --poso: url(#poso-alto);
  }

  .fruto__poso {
    fill: var(--poso);
    pointer-events: none;
  }
  .fruto__tallo {
    /* Degradado horizontal, no relleno plano: un tallo de un solo tono se
       lee como un rectángulo, no como algo cilíndrico. */
    fill: var(--carne);
    stroke: var(--tinta);
    stroke-width: 1.3;
  }
  .fruto__sombrero {
    /* El domo es lo que más volumen pide: claro cerca del umbo, hondo
       contra el margen. Es la diferencia entre un hongo y una pastilla. */
    fill: var(--domo);
    stroke: var(--tinta);
    stroke-width: 1.5;
  }
  .fruto__margen {
    fill: var(--margen);
    stroke: none;
    pointer-events: none;
  }
  .fruto__laminillas path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 0.8;
    /* Sube de 0.62: ahora corren sobre la banda oscurecida del margen. */
    opacity: 0.78;
  }
  .fruto__fibras path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 0.6;
    opacity: 0.3;
  }
  .fruto__anillo {
    fill: var(--carne);
    stroke: var(--tinta);
    stroke-width: 1.1;
  }
  /* El tramado va por encima del relleno ámbar: es el volumen del sombrero. */
  .fruto__trama path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 0.7;
    opacity: 0.28;
    stroke-linecap: round;
  }

  .plomada {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 0.8;
    opacity: 0.45;
  }

  /* ---------------------------------------------------------------
     La ficha del espécimen. Un rótulo suelto se leía como parte del
     dibujo; una etiqueta con borde, título y descripción se lee como
     algo que se abre. Es el mismo pliego del índice, en miniatura.

     Las medidas van en px porque adentro del foreignObject un px ES
     una unidad de lienzo: escalan con el viewBox junto al resto.
     --------------------------------------------------------------- */
  .ficha-nodo {
    box-sizing: border-box;
    height: 100%;
    padding: 11px 12px;
    background: var(--papel-alto);
    border: 1px solid var(--filete);
    box-shadow: inset 0 0 0 1px var(--papel-alto), inset 0 0 0 2px var(--filete-tenue);
    /* El objetivo del click son el círculo y el rect de .area, que están
       adentro del <a>. Sin esto el HTML se los come. */
    pointer-events: none;
    transition: border-color 0.3s ease, opacity 0.35s ease;
  }
  /* Una sola línea, sí o sí: si la meta se parte en dos, empuja el título y
     el resumen se come el alto fijo de la caja. */
  .ficha-nodo__meta {
    margin: 0;
    font-family: var(--fuente-campo);
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ficha-nodo__titulo {
    margin: 3px 0 0;
    font-family: var(--fuente-especimen);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.15;
    color: var(--tinta);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
  }
  .ficha-nodo__flecha {
    margin-left: 6px;
    font-family: var(--fuente-campo);
    font-size: 13px;
    color: var(--tinta-suave);
    transition: color 0.3s ease;
  }
  .ficha-nodo__resumen {
    margin: 5px 0 0;
    font-family: var(--fuente-cuerpo);
    font-size: 13px;
    line-height: 1.32;
    color: var(--tinta-suave);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nodo[data-estado='semilla'] .ficha-nodo__titulo { color: var(--tinta-suave); }
  /* Lo único que asoma sobre la tierra también manda en la lámina. */
  .nodo[data-estado='fruto'] .ficha-nodo { border-color: var(--tinta-suave); }

  .dominios text,
  .escala text {
    font-family: var(--fuente-campo);
    font-size: 15px;
    fill: var(--tinta-suave);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .escala text {
    font-size: 13px;
    opacity: 0.75;
  }
  .escala__hito {
    fill: var(--tinta);
    opacity: 1;
    font-weight: 700;
  }

  /* En la lámina vertical el lienzo es angosto: el texto necesita cuerpo. */
  .hoja--alto .ficha-nodo__titulo { font-size: 20px; }
  .hoja--alto .ficha-nodo__resumen { font-size: 14px; }
  .hoja--alto .escala text { font-size: 14px; }

  /* ---------------------------------------------------------------
     La recompensa al explorar: al apuntar un hongo, el camino que su
     micelio recorre por la red se ilumina y el resto se apaga.
     Vale igual para el foco de teclado y para el primer toque en táctil.
     --------------------------------------------------------------- */
  .corte.rastreando .hifa:not(.viva) .hifa__filamento,
  .corte.rastreando .hifa:not(.viva) .hifa__rama { opacity: 0.12; }
  .corte.rastreando .hifa:not(.viva) .hifa__savia { opacity: 0; }
  .corte.rastreando .rootlets path { opacity: 0.16; }
  .corte.rastreando .nodo:not(.activo):not(.conexo) .ficha-nodo { opacity: 0.22; }
  .corte.rastreando .nodo:not(.activo):not(.conexo) .nodo-glifo { opacity: 0.22; }
  .corte.rastreando .nodo:not(.activo):not(.conexo) .fruto { opacity: 0.28; }

  .hifa.viva .hifa__filamento {
    stroke: var(--ambar-hondo);
    stroke-width: 2.1;
  }
  .hifa.viva .hifa__rama {
    stroke: var(--ambar-hondo);
    opacity: 0.9;
  }
  /* Al rastrear un camino, la savia de ese camino se engrosa. */
  .hifa.viva .hifa__savia {
    stroke-width: 4;
    opacity: 1;
  }

  .nodo.activo .ficha-nodo { border-color: var(--tinta); }
  .nodo.activo .ficha-nodo__titulo,
  .nodo.activo .ficha-nodo__flecha { color: var(--ambar-hondo); }

  /* nota abierta: queda marcada de forma permanente */
  .nodo.es-activo .ficha-nodo {
    border-color: var(--ambar-hondo);
    border-left-width: 4px;
    background: rgba(196, 135, 26, 0.09);
  }
  .nodo.es-activo .ficha-nodo__titulo { color: var(--ambar-hondo); }

  .leyenda {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    color: var(--tinta-suave);
    font-size: 0.78rem;
    text-align: center;
  }
  .leyenda__accion { color: var(--ambar-hondo); }

  /* ---------------------------------------------------------------
     Movimiento ambiental: el micelio respira. Muy poco, muy lento.
     La media query global de reduced-motion lo apaga entero.
     --------------------------------------------------------------- */
  @keyframes respirar {
    0%, 100% { transform: translate3d(0, 0, 0); opacity: 0.55; }
    50%      { transform: translate3d(0, 2px, 0); opacity: 0.72; }
  }
  .rootlets--a { animation: respirar 17s ease-in-out infinite; }
  .rootlets--b { animation: respirar 23s ease-in-out infinite reverse; }

  /* La regla global apaga las animaciones, pero no alcanza acá: la savia
     quedaría congelada como un muñón ámbar al inicio de cada hifa. Sin
     movimiento no hay savia, así que se oculta. */
  @media (prefers-reduced-motion: reduce) {
    .hifa__savia,
    .fruto__savia {
      display: none;
    }
  }
</style>

<script>
  const corte = document.querySelector<HTMLElement>('.corte');
  if (corte) {
    // En táctil no hay hover: el primer toque traza la red, el segundo entra.
    const tactil = window.matchMedia('(hover: none)').matches;
    let trazado: string | null = null;

    // Solo la lámina visible tiene nodos con caja: la otra está en display:none.
    const nodos = [...corte.querySelectorAll<SVGAElement>('.nodo')];
    const hifas = [...corte.querySelectorAll<SVGGElement>('.hifa')];

    const activo = corte.dataset.activo;
    if (activo) {
      corte
        .querySelectorAll(`.nodo[data-slug="${activo}"]`)
        .forEach((n) => n.classList.add('es-activo'));
    }

    const soltar = () => {
      corte.classList.remove('rastreando');
      nodos.forEach((o) => o.classList.remove('activo', 'conexo'));
      hifas.forEach((h) => h.classList.remove('viva'));
      trazado = null;
    };

    const rastrear = (slug: string) => {
      soltar();
      const vecinos = new Set<string>();
      hifas.forEach((h) => {
        const { a, b } = h.dataset;
        if (a === slug) vecinos.add(b!);
        if (b === slug) vecinos.add(a!);
        if (a === slug || b === slug) h.classList.add('viva');
      });
      // Las dos láminas comparten slugs: marcar por slug sirve para ambas.
      nodos.forEach((o) => {
        const s = o.dataset.slug!;
        if (s === slug) o.classList.add('activo');
        else if (vecinos.has(s)) o.classList.add('conexo');
      });
      corte.classList.add('rastreando');
      trazado = slug;
    };

    nodos.forEach((nodo) => {
      const slug = nodo.dataset.slug!;

      if (!tactil) {
        nodo.addEventListener('mouseenter', () => rastrear(slug));
        nodo.addEventListener('mouseleave', soltar);
      }

      // El teclado recorre la red igual que el mouse.
      nodo.addEventListener('focus', () => rastrear(slug));
      nodo.addEventListener('blur', soltar);

      if (tactil) {
        nodo.addEventListener('click', (e) => {
          if (trazado !== slug) {
            // primer toque: mostrar la red, no navegar todavía
            e.preventDefault();
            rastrear(slug);
          }
          // segundo toque sobre el mismo nodo: dejar pasar la navegación
        });
      }
    });

    // Tocar fuera de un nodo apaga el rastreo.
    if (tactil) {
      corte.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.nodo')) soltar();
      });
    }
  }
</script>
